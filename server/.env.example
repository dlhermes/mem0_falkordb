# =============================================================================
# mem0 Server 环境变量 — 基础设施配置
# =============================================================================
# 复制本文件为 .env 后按需修改。
# docker-compose 启动时会自动加载同目录下的 .env。
#
# ⚠️ 模型配置（LLM / Embedder / Reranker / Graph Store 的 provider、api_key、
#   model、api_base）请写在 config.json 中，不要放在这里。
#   详见 config.json.example。
#
# 生产部署时需额外设置以下变量（compose 中使用 ${VAR:-default} 语法，
# 此处定义即覆盖默认值，不定义则使用 localhost 默认值）：
#   DASHBOARD_URL — Dashboard 完整 URL（http://IP:3002），用于 CORS / cookie secure 判断
#   API_EXTERNAL_URL — API 外部访问地址（http://IP:8888），Dashboard 浏览器端调此地址
#   NODE_ENV — Next.js 运行模式，生产部署建议 production
# =============================================================================

# ── 生产部署（compose 变量替换） ──────────────────────────────────────────────
# compose 中使用 ${VAR:-default}，以下在 .env 中定义即覆盖默认值。
# 部署到非本机时必须设置，不设则默认 localhost（仅本机可用）。

# Dashboard 完整 URL（用于 CORS 来源 + cookie secure 协议判断）
# DASHBOARD_URL=http://你的IP:3002
# API 外部访问地址（Dashboard 浏览器端调此地址访问 API）
# API_EXTERNAL_URL=http://你的IP:8888
# Next.js 运行模式（development / production）
# NODE_ENV=production

# ── Postgres ────────────────────────────────────────────────────────────────

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

# ── FalkorDB 图存储 ─────────────────────────────────────────────────────────

FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_DATABASE=mem0

# ── 认证与安全 ──────────────────────────────────────────────────────────────

ADMIN_API_KEY=
JWT_SECRET=
# 仅本地开发时设为 true。生产环境务必保持 false。
AUTH_DISABLED=false

# Mem0 Cloud API Key（使用 mem0 云端服务时需要）
# 如果同时部署了本 Server，则无需此项；仅在使用 mem0 云平台 SDK 时设置。
# MEM0_API_KEY=

# ── Dashboard ───────────────────────────────────────────────────────────────
# DASHBOARD_URL 请在上方「生产部署」段中设置

# ── 配置文件 ────────────────────────────────────────────────────────────────

# Provider 配置 JSON 文件路径（替代 /configure API）
# 此文件包含 LLM / Embedder / Reranker / Graph Store 的 provider 配置
MEM0_CONFIG_PATH=/app/config.json

APP_DB_NAME=mem0_app

# Mem0 数据/配置目录。CLI 模式和 SDK 本地模式用此路径存储配置和历史。
# 默认 ~/.mem0，Server 模式下通常无需设置。
# MEM0_DIR=/app/.mem0

# ── 历史记录 ────────────────────────────────────────────────────────────────

HISTORY_DB_PATH=/app/history/history.db

# ── Telemetry ───────────────────────────────────────────────────────────────

# 匿名遥测（仅发送一次安装事件：install UUID、邮箱域名、server version、source）。无 PII。
MEM0_TELEMETRY=true
# MEM0_TELEMETRY_STATE_PATH=/app/history/telemetry.json
# MEM0_TELEMETRY_SAMPLE_RATE=0.1  # SDK 遥测采样率（0.0-1.0，默认 1.0）

# ── 日志清理 ────────────────────────────────────────────────────────────────

# prune-logs 执行时保留多少天的 request_logs 历史
REQUEST_LOG_RETENTION_DAYS=30

# ═════════════════════════════════════════════════════════════════════════════
# 性能调优
# ═════════════════════════════════════════════════════════════════════════════

# ── 数据库连接池 ────────────────────────────────────────────────────────────

# MEM0_DB_POOL_SIZE=10            # SQLAlchemy pool_size
# MEM0_DB_MAX_OVERFLOW=20         # pool 满载后可额外创建的连接数
# MEM0_DB_POOL_RECYCLE=3600       # 连接最大存活秒数（-1 = 不回收）
# MEM0_DB_POOL_TIMEOUT=30         # 等待空闲连接的超时秒数

# ── 向量库连接池（pgvector）──────────────────────────────────────────────────

# MEM0_VECTOR_MINCONN=3            # pgvector 最小连接数
# MEM0_VECTOR_MAXCONN=10           # pgvector 最大连接数

# ── LLM 调优 ────────────────────────────────────────────────────────────────

# MEM0_LLM_TEMPERATURE=0.2        # 记忆提取温度（0-2，越低越确定）
# MEM0_LLM_MAX_TOKENS=2000        # 单次 LLM 调用最大输出 token
# MEM0_LLM_MAX_INPUT_TOKENS=0     # 长消息自动分块阈值（0 = 不分块）
# MEM0_LLM_TIMEOUT=60             # LLM HTTP 请求超时秒数
# MEM0_LLM_MAX_RETRIES=2          # LLM 请求失败最大重试次数
# MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14  # 服务端默认 LLM 模型（config.json 未指定时生效）

# ── Embedder 调优 ───────────────────────────────────────────────────────────

# MEM0_EMBEDDING_DIMS=1536        # 向量维度（自动检测，通常无需设置）
# MEM0_EMBEDDING_BATCH_SIZE=100   # 批量嵌入每批最大条数
# MEM0_EMBEDDER_TIMEOUT=60        # Embedder HTTP 请求超时秒数
# MEM0_EMBEDDER_MAX_RETRIES=2     # Embedder 请求失败最大重试次数
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small  # 服务端默认 Embedder 模型（config.json 未指定时生效）

# ── Reranker 调优 ───────────────────────────────────────────────────────────
#
# 通过 config.json 配置 Provider 后，Server /search API 自动启用重排序。
# 支持：siliconflow / zero_entropy / cohere / sentence_transformer / huggingface / llm_reranker
# 详见：https://docs.mem0.ai/components/rerankers/config
#
# MEM0_RERANK_TIMEOUT=60          # Reranker HTTP 请求超时秒数
# MEM0_RERANK_MAX_RETRIES=2       # Reranker 请求失败最大重试次数
# MEM0_RERANK_REQUEST_DELAY=0     # LLMReranker 逐文档调 LLM 时每次请求间隔（秒），防 RPM 限制

# ── Graph Store 调优 ────────────────────────────────────────────────────────

# MEM0_GRAPH_MAX_WORKERS=1        # 图实体提取并发数（1 = 串行）

# ── 记忆衰减 ────────────────────────────────────────────────────────────────

# MEM0_ENABLE_DECAY=false         # true=启用记忆衰减（搜索时按时间加权）
# MEM0_DECAY_HALF_LIFE_DAYS=30   # 衰减半衰期天数

# ── 记忆清理 ─────────────────────────────────────────────────────────────────

# MEMORY_RETENTION_DAYS=0         # 超期记忆清理天数（0 = 仅清理显式过期记忆）
# PRUNE_DRY_RUN=true              # 干跑模式（只报告不删除）

# ── 定期合并 ─────────────────────────────────────────────────────────────────

# CONSOLIDATION_DRY_RUN=true      # 干跑模式
# CONSOLIDATION_MIN_GROUP=3       # 触发合并的最少记忆条数

# ── 矛盾检测 ─────────────────────────────────────────────────────────────────

# MEM0_ENABLE_CONTRADICTION=false  # true=启用写入时矛盾检测（复用 LLM 提取）

# ── 其他 Provider Key（按需启用 — ⚠️ 更推荐写在 config.json 中） ──────────

# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# COHERE_API_KEY=
# ZERO_ENTROPY_API_KEY=
