{
  "llm": {
    "provider": "openai",
    "config": {
      "api_key": "sk-你的Key",
      "model": "gpt-4o-mini",
      "temperature": 0.1,
      "max_tokens": 2000,
      "openai_base_url": ""
    }
  },
  "embedder": {
    "provider": "openai",
    "config": {
      "api_key": "sk-你的Key",
      "model": "text-embedding-3-small",
      "openai_base_url": "",
      "embedding_dims": 1536
    }
  },
  "reranker": {
    "provider": "siliconflow",
    "config": {
      "model": "BAAI/bge-reranker-v2-m3",
      "api_key": "sk-你的Key"
    }
  },
  "graph_store": {
    "provider": "falkordb",
    "config": {
      "host": "falkordb",
      "port": 6379,
      "database": "mem0"
    }
  },
  "custom_instructions": "提取事实时，为每条记忆标注时间属性：\n- PAST: 已发生的事件（如\"昨天去了医院\"）\n- PRESENT: 当前状态（如\"住在北京\"）\n- FUTURE: 计划/意图（如\"下周要去东京\"）\n- TIMELESS: 永恒事实（如\"姓名是张三\"）\n\n将 temporal 值写入 metadata.temporal 字段。\n如果有明确日期，同时写入 metadata.temporal_date（ISO 格式 yyyy-MM-dd）。\n"
}
